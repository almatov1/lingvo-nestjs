// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int         @id @default(autoincrement())
  telegramId    BigInt      @unique
  data          String?
  language      Language    @default(kk)
  level         Level?
  format        Format?

  currentStep   Step        @default(CHOOSE_LANGUAGE)
  testAnswers   Int[]

  currentLevel    Level?
  currentTopic    Int?
  currentTask     TaskType?

  uiScreen    OnlineScreen?

  isLevelCompleted    Boolean   @default(false)

  updatedAt   DateTime?   @updatedAt  @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)

  results   TopicResult[]
}

enum Language {
  kk
  ru
  en
}

enum Level {
  A1
  A2
  B1
  B2
  C1
}

enum Format {
  Online
  Offline
}

enum Step {
  CHOOSE_LANGUAGE
  REGISTRATION
  PLACEMENT_TEST
  LEARNING_FORMAT
  FORMAT_OFFLINE
  FORMAT_ONLINE
  COMPLETED
}

enum TaskType {
  WRITING
  READING
  LISTENING
  SPEAKING
}

enum OnlineScreen {
  MENU
  LEVELS
  TOPICS
  TASK
}

model TopicResult {
  id    Int   @id @default(autoincrement())

  userId    Int
  level     Level
  topic     Int

  writingAnswer       String?
  readingAnswer       String[]
  listeningAnswer     String?
  speakingFile        String?

  updatedAt   DateTime?   @updatedAt  @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level, topic])
}
